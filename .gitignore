# The self-contained toolchain - JDK, Gradle, SDK, NDK, CMake. About 3.8 GB, all
# of it downloadable. See README for what versions to put here.
toolchain/

# Machine-specific: build.sh writes this on first run.
android/local.properties

# Build output
android/.gradle/
android/app/build/
android/app/.cxx/
*.apk

# The sample panoramas - other people's photographs, so not redistributed here.
# reference/README.md records the size, hash and geometry of each, so you can
# confirm you have the right file.
reference/testdata/

# ffmpeg ground truth for the tests - ~193 MB, regenerated byte-identically by
# reference/make_truth.sh from the files in reference/testdata.
reference/truth/

# Scratch renders from the desktop tooling
reference/out_capped.rgb
reference/__pycache__/

.DS_Store

# The ambience track - someone else's music, so not redistributed here. Drop any
# mp3 in as android/app/src/main/res/raw/ambience.mp3; the app looks it up by name
# and simply runs silent if it is absent.
android/app/src/main/res/raw/
*.mp3

# Your own source material. These are other people's 1990s photographs - the same
# reason reference/testdata is not here. ~130 MB, and not ours to redistribute.
Imports/

# Scratch renders from the desktop tooling: cube orientation checks, gradient
# previews. Regenerated by the scripts in reference/ whenever they are needed.
reference/*.png
reference/*.rgb

# Scratch folder the desktop app drops co-work output into. AppleZip.kt was moved
# from here into the source tree; this is a staging area, not a source of truth.
Claude outputs/
